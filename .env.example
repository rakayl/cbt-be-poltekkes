# ==============================================================================
# BACKEND ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env and adjust values for your environment.
# Docker Compose reads .env automatically — no extra setup needed.
#
# ⚠️  NEVER commit .env to Git! Only .env.example is tracked.
# ==============================================================================

# Server Port
PORT=5000

# ──────────────────────────────────────────────────────────────────────────────
# Primary Database (CBT)
# ──────────────────────────────────────────────────────────────────────────────
DB_HOST=host.docker.internal
DB_PORT=5433
DB_USER=postgres
DB_PASS=postgres
DB_NAME=cat
DB_SSLMODE=disable

# ──────────────────────────────────────────────────────────────────────────────
# SIAKAD Database (Optional — falls back to primary DB if not set)
# ──────────────────────────────────────────────────────────────────────────────
# DB_SIAKAD_HOST=host.docker.internal
# DB_SIAKAD_PORT=5433
# DB_SIAKAD_USER=postgres
# DB_SIAKAD_PASS=postgres
# DB_SIAKAD_NAME=cat
# DB_SIAKAD_SSLMODE=disable
