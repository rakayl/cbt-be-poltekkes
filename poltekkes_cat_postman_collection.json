		{
			"name": "1. SSO & Autentikasi",
			"item": [
				{
					"name": "Login Administrator (Gate SSO)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.result && jsonData.result.data && jsonData.result.data.access_token) {",
									"    pm.collectionVariables.set('adminToken', jsonData.result.data.access_token);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"username\": \"admin\",\n  \"password\": \"password\",\n  \"remember_me\": true\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/auth/login",
							"host": ["{{baseUrl}}"],
							"path": ["auth", "login"]
						},
						"description": "Autentikasi admin SIM / pengawas ujian untuk mendapatkan Bearer JWT token."
					}
				},
				{
					"name": "Login Peserta CBT",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"var jsonData = pm.response.json();",
									"if (jsonData.result && jsonData.result.data && jsonData.result.data.participant_token) {",
									"    pm.collectionVariables.set('participantToken', jsonData.result.data.participant_token);",
									"    if (jsonData.result.data.active_schedules && jsonData.result.data.active_schedules.length > 0) {",
									"        pm.collectionVariables.set('scheduleId', jsonData.result.data.active_schedules[0].schedule_id.toString());",
									"    }",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"participant_code\": \"2830001120007\",\n  \"password\": \"password\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/auth/participant/login",
							"host": ["{{baseUrl}}"],
							"path": ["auth", "participant", "login"]
						},
						"description": "Autentikasi peserta ujian CBT menggunakan nomor peserta dan kata sandi/PIN."
					}
				},
				{
					"name": "Get Daftar Modul & Menu Gate",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/auth/menus?module=cat&role=admin",
							"host": ["{{baseUrl}}"],
							"path": ["auth", "menus"],
